{
  "$id": "https://github.com/Govardhan527/controlproof/schemas/manifest/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "sha256",
      "default": "sha256",
      "title": "Algorithm",
      "type": "string"
    },
    "files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Files",
      "type": "object"
    },
    "run_id": {
      "pattern": "^\\d{8}T\\d{6}Z$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "files"
  ],
  "title": "Manifest",
  "type": "object"
}
