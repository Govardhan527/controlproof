{
  "$defs": {
    "JsonValue": {},
    "ProfileControl": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z]{2}-\\d+(\\.\\d+)?$",
          "title": "Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "title": "ProfileControl",
      "type": "object"
    }
  },
  "$id": "https://github.com/Govardhan527/controlproof/schemas/profile/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "controls": {
      "items": {
        "$ref": "#/$defs/ProfileControl"
      },
      "minItems": 1,
      "title": "Controls",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "provider": {
      "const": "aws",
      "title": "Provider",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "provider",
    "controls"
  ],
  "title": "Profile",
  "type": "object"
}
