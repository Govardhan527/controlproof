{
  "$defs": {
    "ControlResult": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "pattern": "^[a-z]{2}-\\d+(\\.\\d+)?$",
          "title": "Control Id",
          "type": "string"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "minItems": 1,
          "title": "Observations",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "method",
        "status",
        "observations",
        "evidence_refs",
        "started_at",
        "ended_at",
        "tool_version"
      ],
      "title": "ControlResult",
      "type": "object"
    },
    "Method": {
      "enum": [
        "inspect",
        "simulate",
        "exercise"
      ],
      "title": "Method",
      "type": "string"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "subjects": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Subjects",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Status": {
      "enum": [
        "pass",
        "fail",
        "error",
        "not_tested"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "$id": "https://github.com/Govardhan527/controlproof/schemas/run-record/1.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account": {
      "pattern": "^[0-9]{12}$",
      "title": "Account",
      "type": "string"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Profile Id",
      "type": "string"
    },
    "regions": {
      "items": {
        "pattern": "^[a-z][a-z0-9-]*[0-9]$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Regions",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/ControlResult"
      },
      "title": "Results",
      "type": "array"
    },
    "run_id": {
      "pattern": "^\\d{8}T\\d{6}Z$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "tool_version": {
      "minLength": 1,
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "profile_id",
    "account",
    "regions",
    "started_at",
    "ended_at",
    "tool_version",
    "results"
  ],
  "title": "RunRecord",
  "type": "object"
}
